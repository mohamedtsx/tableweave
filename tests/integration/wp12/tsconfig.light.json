{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "../../..",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "ES2023", "ES2023.Intl", "DOM", "DOM.Iterable"],
    "types": ["node", "react", "react-dom"],
    "paths": {
      "@tableweave/react": ["../../../packages/react/src/index.ts"],
      "@tableweave/react/contracts": [
        "../../../packages/react/src/contracts/index.ts"
      ],
      "@tableweave/react/filters": [
        "../../../packages/react/src/filters/index.ts"
      ],
      "@tableweave/react/reordering-controller": [
        "../../../packages/react/src/reordering-controller/index.ts"
      ],
      "@tableweave/react/reordering": [
        "../../../packages/react/src/reordering/index.ts"
      ],
      "@tableweave/heroui": ["../../../packages/heroui/src/index.ts"],
      "@heroui/react/*": [
        "../../../apps/storybook/node_modules/@heroui/react/dist/components/*/index.d.ts"
      ],
      "react-aria/*": [
        "../../../apps/storybook/node_modules/react-aria/dist/types/exports/*.d.ts"
      ],
      "@internationalized/date": [
        "../../../packages/heroui/node_modules/@internationalized/date"
      ],
      "@tanstack/react-table": [
        "../../../packages/react/node_modules/@tanstack/react-table/dist/index.d.ts"
      ],
      "@vitejs/plugin-react": [
        "../../../apps/storybook/node_modules/@vitejs/plugin-react/dist/index.d.ts"
      ],
      "@tailwindcss/vite": [
        "../../../apps/storybook/node_modules/@tailwindcss/vite/dist/index.d.mts"
      ]
    }
  },
  "include": ["./*.ts", "./*.tsx"],
  "exclude": ["./evidence/**"]
}
