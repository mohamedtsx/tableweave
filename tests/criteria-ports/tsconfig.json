{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": {
      "@internationalized/date": [
        "../../packages/heroui/node_modules/@internationalized/date"
      ],
      "@tableweave/react": ["../../packages/react/src/index.ts"],
