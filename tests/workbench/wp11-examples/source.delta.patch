+      id: "review",
+      header: "Application action",
+      meta: { utility: true },
+      cell: ({ row }) => (
+        <Button variant="tertiary" size="sm" onPress={() => review(row.id)}>
+          Review {row.id}
+        </Button>
+      ),
+    },
+  ];
+}
