+const root = fileURLToPath(new URL("../../../", import.meta.url));
+const exact = {
+  "apps/examples/vite/": [
+    "README.md",
+    "headless.html",
+    "headless.tsx",
+    "index.html",
+    "main.tsx",
+    "styles.css",
+  ],
+  "apps/examples/recipes/": [
+    "README.md",
+    "custom-cells.tsx",
+    "custom-filter.tsx",
+    "locale-recovery.tsx",
+    "row-bulk-actions.tsx",
+  ],
+  "apps/example-start/src/recipes/wp11/": [
+    "README.md",
+    "TableRecipe.tsx",
+    "query-options.ts",
+    "table-owner.ts",
+  ],
+};
+const allowed = new Set([
+  "@tableweave/react",
+  "@tableweave/react/contracts",
+  "@tableweave/react/filters",
+  "@tableweave/react/reordering-controller",
+  "@tableweave/react/reordering",
+  "@tableweave/heroui",
+]);
+function specifiers(file) {
+  const result = [];
+  function visit(node) {
+    if (
+      (ts.isImportDeclaration(node) || ts.isExportDeclaration(node)) &&
+      node.moduleSpecifier &&
+      ts.isStringLiteral(node.moduleSpecifier)
+    )
+      result.push(node.moduleSpecifier.text);
+    if (
+      ts.isImportTypeNode(node) &&
+      ts.isLiteralTypeNode(node.argument) &&
+      ts.isStringLiteral(node.argument.literal)
+    )
+      result.push(node.argument.literal.text);
+    if (
+      ts.isCallExpression(node) &&
+      node.expression.kind === ts.SyntaxKind.ImportKeyword &&
+      node.arguments[0] &&
+      ts.isStringLiteral(node.arguments[0])
+    )
+      result.push(node.arguments[0].text);
+    ts.forEachChild(node, visit);
+  }
+  visit(file);
+  return result;
+}
+for (const [directory, names] of Object.entries(exact)) {
+  assert.deepEqual(
+    (await readdir(resolve(root, directory))).sort(),
+    names.sort(),
+  );
