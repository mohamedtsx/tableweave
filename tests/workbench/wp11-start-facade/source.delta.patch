+  }
+  return {
+    D,
+    C,
+    P,
+    resource,
+    criteria,
+    activate() {
+      if (!activated && live && port.isCurrent()) {
+        activated = true;
+        load();
+      }
+    },
+    refresh() {
+      load(true);
+    },
+    isCurrent: () => live && port.isCurrent(),
+    registerDraft(clear: () => void) {
+      drafts.add(clear);
+      return () => {
+        drafts.delete(clear);
+        clear();
+      };
+    },
+    modelOptions(): DataTableOptions<S, T> {
+      const view = resource.getSnapshot();
+      return {
+        controller: C,
+        publication: P,
+        criteria,
+        expected: context,
+        source: {
+          mode: "server",
+          resource,
