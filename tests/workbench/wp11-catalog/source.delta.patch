+    ...helper,
+    get lease() {
+      return lease;
+    },
+    get operation() {
+      return operation;
+    },
+    get notice() {
+      return notice;
+    },
+    get canSettle() {
+      return operation !== null && !reported;
+    },
+    get canPublish() {
