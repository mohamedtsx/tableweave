+      result.status === "ignored" &&
+      (result.reason === "authority" || result.reason === "reentrant")
+    ) {
+      held = receipt;
+      notice =
+        "Exact synthetic transport notice held until a coherent model commit; no outcome was invented.";
+      return;
+    }
