{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node", "react", "react-dom"],
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "next": ["./node_modules/next/index.d.ts"],
      "@tableweave/react": ["../../packages/react/src/index.ts"],
      "@tableweave/react/contracts": [
        "../../packages/react/src/contracts/index.ts"
      ],
      "@tableweave/react/filters": [
        "../../packages/react/src/filters/index.ts"
      ],
      "@tableweave/react/reordering": [
        "../../packages/react/src/reordering/index.ts"
      ],
      "@tableweave/react/reordering-controller": [
        "../../packages/react/src/reordering-controller/index.ts"
      ],
      "@tableweave/heroui": ["../../packages/heroui/src/index.ts"],
      "@heroui/react/*": [
        "./node_modules/@heroui/react/dist/components/*/index.d.ts"
      ],
      "@internationalized/date": ["./node_modules/@internationalized/date"],
      "@tanstack/react-table": [
        "./node_modules/@tanstack/react-table/dist/index.d.ts"
      ],
      "react-aria-components/I18nProvider": [
        "./node_modules/react-aria-components/dist/types/exports/I18nProvider.d.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "styles.d.ts",
    "*.mjs",
    "app/**/*.ts",
    "app/**/*.tsx",
    "lib/**/*.ts",
    "../../tests/workbench/wp11-next/*.ts",
    "../../tests/workbench/wp11-next/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "../../tests/workbench/wp11-next/negative",
    "../../tests/workbench/wp11-next/packed",
    "../../tests/workbench/wp11-next/.artifacts"
  ]
}
